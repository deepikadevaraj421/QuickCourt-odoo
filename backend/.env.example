# Server
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Database (Prisma). SQLite file by default; swap for a Postgres/MySQL URL if needed.
DATABASE_URL="file:./dev.db"

# Auth
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=5

# SMTP (used to email OTP codes). If left empty in development, the OTP is
# printed to the backend console only. Required in production.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="QuickCourt <no-reply@quickcourt.local>"

# Optional: seed a single ADMIN account with `npm run seed:admin`.
# Admin registration is never exposed publicly.
ADMIN_NAME=QuickCourt Admin
ADMIN_EMAIL=
ADMIN_PASSWORD=
